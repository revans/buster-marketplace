{
  "description": "Lens plugin - reinjects active lens context before every prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.dna/lens/active.md 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
